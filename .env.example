# SQLite database file. NOTE: Prisma resolves a relative sqlite path relative
# to prisma/schema.prisma, not the project root — so "./dev.db" here means
# prisma/dev.db, which is what you want. Do not change this to "./prisma/dev.db"
# (that resolves to the confusing prisma/prisma/dev.db).
DATABASE_URL="file:./dev.db"

# Optional: enables LLM-assisted classification for ambiguous pages.
# The app works fully without this — deterministic heuristics are the default
# and only fallback path. See README > "How Analysis Works".
ANTHROPIC_API_KEY=

# Crawl tuning (all optional, sensible defaults are used if omitted)
CRAWL_MAX_PAGES=100
CRAWL_MAX_DEPTH=5
CRAWL_CONCURRENCY=8
CRAWL_REQUEST_TIMEOUT_MS=10000
